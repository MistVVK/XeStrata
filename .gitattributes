# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf

# Chat templates are rendered byte for byte (the served prompt, the pack's chat_golden.json): LF wherever the
# repository is cloned, so a Windows checkout with core.autocrlf=true does not turn them into CRLF.
*.jinja text eol=lf

# Pack fixtures are parsed byte for byte.
tests/data/native_experts/** -text

# vendored KaTeX: the files are hashed byte for byte (PROVENANCE.json), never convert their line endings.
third_party/main/katex/** -text
