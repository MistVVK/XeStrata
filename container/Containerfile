# XeStrata in a container: the Fedora 45 package from the GitHub Releases (or an rpm put in container/rpm/), with the
# GPU makers' libraries the package records.  Built on the user's PC (podman compose build), never distributed: the
# contrib packages' cuBLAS and oneMKL are not free software.  docs/BUILD.md#podman
# the image tools/package/build.sh builds the Fedora 45 packages in
ARG FEDORA=docker.io/library/fedora@sha256:53d138f25f6738257c78553d51369b662efc0e0eb1cd1556a2fe0ad5a115be88
FROM ${FEDORA}
ARG XESTRATA_VERSION=latest
ARG XESTRATA_VARIANT=contrib-cuda13.5
ARG XESTRATA_NONFREE=1
# the version of AMD's ROCm for AMD GPUs (install.sh), or fedora: Fedora's own
ARG XESTRATA_ROCM=10.1
# (relabel: SELinux lets the build read the folder)
RUN --mount=type=bind,source=.,target=/ctx,relabel=shared \
    XESTRATA_VERSION="$XESTRATA_VERSION" XESTRATA_VARIANT="$XESTRATA_VARIANT" XESTRATA_NONFREE="$XESTRATA_NONFREE" \
    XESTRATA_ROCM="$XESTRATA_ROCM" sh /ctx/install.sh
# the browser is the host's: the server only listens (on the host's loopback, compose.yaml)
ENTRYPOINT ["xestrata"]
CMD ["--no-browser"]
