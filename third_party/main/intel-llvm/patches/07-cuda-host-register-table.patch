cuda-host-register-table: a fix to intel/llvm v7.1.1, applied by tools/intel_llvm_build.py.

The CUDA adapter left urUSMImportExp and urUSMReleaseExp out of its table, so the loader refused them
(UR_RESULT_ERROR_UNINITIALIZED); with cuda-host-register.
---
diff --git a/unified-runtime/source/adapters/cuda/ur_interface_loader.cpp b/unified-runtime/source/adapters/cuda/ur_interface_loader.cpp
index 50c588d..64ad4b7 100644
--- a/unified-runtime/source/adapters/cuda/ur_interface_loader.cpp
+++ b/unified-runtime/source/adapters/cuda/ur_interface_loader.cpp
@@ -5,6 +5,7 @@
 // Part of the Unified-Runtime Project, under the Apache License v2.0 with LLVM
 // Exceptions. See LICENSE.TXT
 // SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Modified 2026 by MistVVK and the XeStrata contributors: host memory registration in the adapter's table (cuda-host-register-table)
 //
 //===----------------------------------------------------------------------===//
 
@@ -444,6 +445,8 @@ UR_DLLEXPORT ur_result_t UR_APICALL urGetUSMExpProcAddrTable(
   pDdiTable->pfnPoolGetDevicePoolExp = urUSMPoolGetDevicePoolExp;
   pDdiTable->pfnPoolTrimToExp = urUSMPoolTrimToExp;
   pDdiTable->pfnContextMemcpyExp = urUSMContextMemcpyExp;
+  pDdiTable->pfnImportExp = urUSMImportExp;
+  pDdiTable->pfnReleaseExp = urUSMReleaseExp;
   return UR_RESULT_SUCCESS;
 }
 
