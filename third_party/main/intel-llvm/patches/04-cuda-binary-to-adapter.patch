cuda-binary-to-adapter: a fix to intel/llvm v7.1.1, applied by tools/intel_llvm_build.py.

The SYCL runtime hands the CUDA adapter the device image itself, as it does the HIP one, for
cuda-select-binary-2 (the single-image path).
---
diff --git a/sycl/source/detail/program_manager/program_manager.cpp b/sycl/source/detail/program_manager/program_manager.cpp
index ab23a1d..58773bb 100644
--- a/sycl/source/detail/program_manager/program_manager.cpp
+++ b/sycl/source/detail/program_manager/program_manager.cpp
@@ -548,6 +548,11 @@ static bool compatibleWithDevice(const RTDeviceBinaryImage *BinImage,
 
   ur_device_binary_t UrBinary{};
   UrBinary.pDeviceTargetSpec = getUrDeviceTarget(DevBin.DeviceTargetSpec);
+  // the CUDA adapter refuses PTX for a newer architecture than the device's
+  std::pair<const unsigned char *, size_t> Blob{
+      DevBin.BinaryStart, std::distance(DevBin.BinaryStart, DevBin.BinaryEnd)};
+  if (DeviceImpl.getBackend() == backend::ext_oneapi_cuda)
+    UrBinary.pNext = &Blob;
 
   ur_result_t Error = Adapter.call_nocheck<UrApiKind::urDeviceSelectBinary>(
       URDeviceHandle, &UrBinary,
