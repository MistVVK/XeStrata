cuda-binaries-to-adapter: a fix to intel/llvm v7.1.1, applied by tools/intel_llvm_build.py.

The SYCL runtime hands the CUDA adapter the device images themselves, as it does the HIP one, for
cuda-select-binary-2 (the several-images path; with cuda-binaries-to-adapter-2).
---
diff --git a/sycl/source/detail/program_manager/program_manager.cpp b/sycl/source/detail/program_manager/program_manager.cpp
index 8e43d89..1309a75 100644
--- a/sycl/source/detail/program_manager/program_manager.cpp
+++ b/sycl/source/detail/program_manager/program_manager.cpp
@@ -4,6 +4,7 @@
 // See https://llvm.org/LICENSE.txt for license information.
 // SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
 // Modified 2026 by MistVVK and the XeStrata contributors: the CUDA adapter is handed the device image itself (cuda-binary-to-adapter)
+// Modified 2026 by MistVVK and the XeStrata contributors: the CUDA adapter is handed every NVIDIA image (cuda-binaries-to-adapter)
 //
 //===----------------------------------------------------------------------===//
 
@@ -1268,10 +1269,12 @@ const RTDeviceBinaryImage *getBinImageFromMultiMap(
     return nullptr;
 
   const size_t NumImgs = DeviceFilteredImgs.size();
-  // Pass extra information to the HIP adapter to aid in binary selection. We
-  // pass it the raw binary as a {ptr, length} pair.
+  // Pass extra information to the HIP and CUDA adapters to aid in binary
+  // selection. We pass it the raw binary as a {ptr, length} pair.
   std::vector<std::pair<const unsigned char *, size_t>> UrBinariesStorage;
-  if (DeviceImpl.getBackend() == backend::ext_oneapi_hip)
+  const bool PassBinaries = DeviceImpl.getBackend() == backend::ext_oneapi_hip ||
+                            DeviceImpl.getBackend() == backend::ext_oneapi_cuda;
+  if (PassBinaries)
     UrBinariesStorage.reserve(NumImgs);
 
   std::vector<ur_device_binary_t> UrBinaries(NumImgs);
