--- a/unified-runtime/source/adapters/hip/device.cpp
+++ b/unified-runtime/source/adapters/hip/device.cpp
@@ -983,7 +983,11 @@
   case UR_DEVICE_INFO_HOST_PIPE_READ_WRITE_SUPPORT:
     return ReturnValue(ur_bool_t{false});
   case UR_DEVICE_INFO_VIRTUAL_MEMORY_SUPPORT:
-    return ReturnValue(ur_bool_t{false});
+    // HIP's virtual memory management (virtual_mem.cpp), where the device and
+    // its driver have it
+    return ReturnValue(ur_bool_t{
+        getAttribute(hDevice,
+                     hipDeviceAttributeVirtualMemoryManagementSupported) != 0});
   case UR_DEVICE_INFO_ESIMD_SUPPORT:
     return ReturnValue(ur_bool_t{false});
   case UR_DEVICE_INFO_TIMESTAMP_RECORDING_SUPPORT_EXP:
