<!-- The launcher's NuGet packages come from nuget.org only: a distribution's SDK adds its own source-built packages as
     a source (its library-packs folder: Fedora's FSharp.Core), whose hashes differ from nuget.org's and from another
     distribution's, so the lock files would hold on one machine only.  Directory.Build.props turns that source off
     (DisableImplicitLibraryPacksFolder); this file clears the user's and the machine's sources. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
